# Release signing config for Google Play. COPY this file to `keystore.properties`
# (which is gitignored) and fill in real values. NEVER commit the real file or the
# .jks keystore itself.
#
# Create the upload keystore first (one time):
#   keytool -genkeypair -v -keystore cycling-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias cycling-upload
# Keep cycling-upload.jks OUT of the repo (e.g. C:\Users\prost\keys\).

storeFile=C:/Users/prost/keys/cycling-upload.jks
storePassword=CHANGE_ME
keyAlias=cycling-upload
keyPassword=CHANGE_ME

# CI alternative: instead of this file, set env vars
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
